# Fleet service configuration. Install at /etc/fleet/fleet.env, mode 0640, owner root:fleet.
#
# This file holds caller-facing configuration only. The CHILD credentials are not here: they live in a
# separate JSON file referenced by FLEET_CREDENTIALS_FILE, because EnvironmentFile contents are readable by
# whoever can read the unit's environment, while the credential file is 0600 and owned by the service user.

# --- secrets -------------------------------------------------------------------
# JSON object of {"ref": "token"} mapping credential_ref -> that Mercury's MERCURY_API_TOKENS value.
# Install: install -m 600 -o fleet -g fleet /dev/null /etc/fleet/credentials.json
#
# ProtectHome=true in fleet.service means the service CANNOT read anything under a home directory, so this
# must be an absolute path outside $HOME. Leaving it unset falls back to ~/.fleet/credentials.json, which
# under systemd resolves to the fleet user's home and fails closed -- every probe reports auth-fail.
FLEET_CREDENTIALS_FILE=/etc/fleet/credentials.json

# --- network -------------------------------------------------------------------
# Loopback by default. Fleet refuses to start on a non-loopback address without TLS, because a caller's
# bearer token would cross the network in plaintext and one Fleet token reaches every Mercury it manages.
FLEET_BIND_HOST=127.0.0.1
FLEET_PORT=3100
# FLEET_TLS_CERT=/etc/fleet/tls/fleet.crt
# FLEET_TLS_KEY=/etc/fleet/tls/fleet.key

# --- caller authentication -----------------------------------------------------
# Format: token:owner[:hosts], comma separated. hosts is `*` or host1+host2.
# Omitting the hosts field grants NOTHING. Widen deliberately with `:*`.
# Generate with: openssl rand -hex 32
FLEET_API_TOKENS=replace-me:operator:*,second-user:analyst:mac-studio
# Full registry control (add/remove/probe hosts). Separate from the caller tokens above.
FLEET_ADMIN_TOKEN=replace-me-admin

# --- storage and probing -------------------------------------------------------
FLEET_DB=/var/lib/fleet/fleet.db
FLEET_PROBE_INTERVAL_MS=15000
FLEET_PROBE_TIMEOUT_MS=5000
FLEET_LOG_LEVEL=info
