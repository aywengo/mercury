# Atlas service configuration. Install at /etc/atlas/atlas.env, mode 0640, owner root:atlas.
#
# Atlas is the project knowledge base: it holds curated notes and serves them to Mercury hosts.
# Its data is the most durable thing in the stack (notes outlive every Run), which is why the
# backup script backs its database up with the same discipline as Mercury's own.

# --- network -------------------------------------------------------------------
# Loopback by default. Atlas refuses to start on a non-loopback address without TLS, because a
# host's contributor token would cross the network in plaintext and a contributor token can write
# every project's knowledge. Terminate TLS in a reverse proxy OR set both TLS variables.
ATLAS_BIND_HOST=127.0.0.1
ATLAS_PORT=4100
# ATLAS_TLS_CERT=/etc/atlas/tls/atlas.crt
# ATLAS_TLS_KEY=/etc/atlas/tls/atlas.key

# --- contributor authentication -------------------------------------------------
# JSON of { "<token>": { "hostId": "<host>", "projects": ["<projectId>"] } }. One token per HOST:
# the hostId is the dedup key for corroboration, so two hosts sharing a token would look like one
# observer agreeing with itself. Install 0600, owner atlas, OUTSIDE /var/lib/atlas (the unit's
# ReadWritePaths) so the service can read it but never write it:
#   install -m 600 -o atlas -g atlas /dev/null /etc/atlas/contributors.json
# ProtectHome=true in atlas.service means the file cannot live under a home directory.
ATLAS_CONTRIBUTORS_FILE=/etc/atlas/contributors.json

# Full curation control (promote/retire/delete notes, manage projects). Separate from the
# contributor tokens above. Generate with: openssl rand -hex 32
ATLAS_ADMIN_TOKEN=replace-me-admin

# --- secrets --------------------------------------------------------------------
# Redaction patterns applied on write AND on read (section 11.5). Empty by default: a deployment
# that never sends secret-bearing notes can leave it so, but anything a host forwards via
# MERCURY_SECRETS should be mirrored here, because Atlas redacts again on its side.
ATLAS_SECRETS=

# --- storage --------------------------------------------------------------------
# The unit's ReadWritePaths admits exactly this directory. Keep the WAL sidecar beside it; the
# backup script covers both.
ATLAS_DB=/var/lib/atlas/atlas.db
ATLAS_LOG_LEVEL=info
