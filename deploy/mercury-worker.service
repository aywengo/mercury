[Unit]
Description=Mercury worker (executes Runs via PrimeAgent)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mercury
Group=mercury
WorkingDirectory=/opt/mercury
EnvironmentFile=/etc/mercury/mercury.env
ExecStart=/usr/bin/env node src/cli.ts worker
Restart=on-failure
RestartSec=5
# Give the worker room to shut down gracefully (issue #51). On SIGTERM it stops claiming,
# signals its in-flight run to terminate the agent and requeue itself, and waits up to
# MERCURY_SHUTDOWN_GRACE_MS (30s default) for that to finish. systemd's default of 90s would
# also work, but naming it here keeps the two numbers visibly coupled: if the in-process grace
# is ever raised, this must rise with it, or SIGKILL wins the race and the graceful path --
# and the requeue -- never runs.
TimeoutStopSec=45
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/mercury /var/lib/mercury
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
