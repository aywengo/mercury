[Unit]
Description=Mercury API server (durable run orchestration for PrimeAgent)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mercury
Group=mercury
WorkingDirectory=/opt/mercury
EnvironmentFile=/etc/mercury/mercury.env
ExecStart=/usr/bin/env node src/cli.ts server
Restart=on-failure
RestartSec=5
# The API server force-closes lingering SSE subscribers after a 2s grace period (issue #52),
# so shutdown is bounded in-process. This is the outer bound: without it, a dashboard holding
# an event stream open could stall `systemctl stop` until SIGKILL.
TimeoutStopSec=15
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/mercury /var/lib/mercury
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
