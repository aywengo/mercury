{
  "name": "@aywengo/mercury",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "author": "Roman Melnyk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aywengo/mercury.git"
  },
  "homepage": "https://github.com/aywengo/mercury#readme",
  "bugs": {
    "url": "https://github.com/aywengo/mercury/issues"
  },
  "keywords": [
    "orchestration",
    "coding-agent",
    "primeagent",
    "long-running-jobs",
    "cli"
  ],
  "description": "Durable long-running coding orchestration for PrimeAgent and other agent backends",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "mercury": "dist/src/cli.js",
    "mercuryctl": "dist/client/bin.js"
  },
  "files": [
    "src/",
    "client/",
    "dist/",
    "!client/test/",
    "ui/",
    ".agents/skills/",
    "local-agents/",
    "remote-agents/",
    "rpc-agents/",
    "deploy/",
    "LICENSE",
    "README.md",
    "QUICKSTART.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "node src/cli.ts dev",
    "server": "node src/cli.ts server",
    "worker": "node src/cli.ts worker",
    "gc": "node src/cli.ts gc",
    "migrate": "node src/cli.ts migrate",
    "typecheck": "tsc --noEmit",
    "build:client": "tsc -p tsconfig.client.json",
    "build:server": "tsc -p tsconfig.server.json",
    "prepare": "npm run build:client && npm run build:server",
    "test": "npm run test:core && npm run test:fleet && npm run test:client",
    "test:core": "node --test --test-timeout=180000 'test/*.test.ts'",
    "test:fleet": "node --test --test-timeout=180000 'fleet/test/*.test.ts'",
    "test:client": "node --test --test-timeout=180000 'client/test/*.test.ts'",
    "fleet": "node fleet/cli.ts",
    "test:e2e": "node --test --test-timeout=900000 'e2e/*.test.ts'",
    "test:e2e:config": "docker compose -f e2e/compose.yml config --quiet",
    "prepr": "node e2e/prepr.ts"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "testcontainers": "^12.1.0",
    "typescript": "^5.8.3"
  }
}
